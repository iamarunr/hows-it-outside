# Public build-time values only. Everything here ships to the browser.
# Never put an API key or secret in this file or in any PUBLIC_* variable.
PUBLIC_SITE_URL=http://localhost:4321
# Leave unset to hide the Source link until a real repository exists.
PUBLIC_SOURCE_URL=
PUBLIC_AUTHOR_URL=https://knnaresh.com
# Set to true for preview/staging builds only: adds noindex meta and X-Robots-Tag.
PUBLIC_NOINDEX=
