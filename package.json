{
  "name": "outside",
  "version": "0.1.0",
  "private": true,
  "description": "Outside? — an open-source outdoor weather decision tool.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/csp-headers.ts && node scripts/verify-dist.ts",
    "preview": "astro preview --port 4321",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "field-check": "node scripts/field-availability.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "astro": "^7.4.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
